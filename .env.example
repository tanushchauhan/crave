# Copy to .env and fill in. Never commit .env.
# Used by scripts/supabase-deploy.sh (Supabase CLI).

# --- Supabase (required for CLI deploy) ---
SUPABASE_ACCESS_TOKEN=
# Project ref (subdomain). Optional if SUPABASE_URL is set — the deploy script derives it.
# SUPABASE_PROJECT_REF=

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Edge runtime secrets (set on remote via deploy script; names must NOT start with SUPABASE_) ---
# Same random string: Lambda INTERNAL_HMAC_SECRET ↔ Edge CRAVE_INTERNAL_SECRET (match-receipt-items).
CRAVE_INTERNAL_SECRET=
INTERNAL_HMAC_SECRET=
# Optional duplicate of SUPABASE_SERVICE_ROLE_KEY; deploy script maps service role automatically if unset.
# CRAVE_SERVICE_ROLE_KEY=

# --- AWS (CLI / bootstrap + infra/aws/scripts/deploy-aws-from-env.sh) ---
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional unique bucket prefix in shared workshop accounts (docs/aws.md §0.1)
# CRAVE_TEAM_SLUG=

# --- Lambda / Bedrock (optional; omit RECEIPT_PARSE_MODEL_ID for receipt OCR stub) ---
# Sonnet 4+ often needs an inference profile id, e.g. us.anthropic.claude-sonnet-4-20250514-v1:0
RECEIPT_PARSE_MODEL_ID=
BEDROCK_TEXT_MODEL_ID=
# Same random string in .env and ElevenLabs Custom LLM "API Key" (Bearer). Enables POST /v1/chat/completions on crave-bedrock-proxy.
ELEVENLABS_CUSTOM_LLM_SECRET=
# Hero image: Nova (works on-demand in most accounts) or Stability SD3.5 text-to-image if it appears in
# `aws bedrock list-foundation-models` for your region. Workshop accounts often only have Nova + Stability *tools* (no SD3.5).
AD_IMAGE_MODEL_ID=amazon.nova-canvas-v1:0
# premium | standard — Nova only
AD_NOVA_QUALITY=premium
# Stability text-to-image only (ignored for Nova). Instagram-friendly default.
AD_IMAGE_ASPECT_RATIO=4:5
# Sonnet returns a flexbox layout tree (Satori subset); Satori + @resvg/resvg-js raster the overlay,
# Sharp composites it over the hero photo with the brand logo. Set to "false" to ship hero+logo only.
AD_OVERLAY_WITH_SVG=true
# Overlay rasterizer. Only "satori" is supported today; reserved for future renderers.
AD_OVERLAY_RENDERER=satori
# Bundle Noto Sans SC (~10MB) into the Lambda zip for CJK glyph coverage. Off by default to keep cold start small.
AD_BUNDLE_CJK_FONT=false
# Which reference image is the logo: -1 = last image in the request array.
AD_LOGO_IMAGE_INDEX=-1
# 1–3. Lower if you must call POST /ads/generate via HTTP API (30s integration cap).
AD_MAX_SLIDES_PER_DESIGN=3
# Optional override for test clients: full Lambda function URL (see deploy script output file).
# AD_GENERATE_URL=
# Titan text embeddings (1536-d) — used by tools/supabase-seed and receipt/menu pipelines.
BEDROCK_EMBEDDING_TEXT_MODEL_ID=amazon.titan-embed-text-v1

# --- Demo DB seed (optional; run: cd tools/supabase-seed && npm install && npm run seed) ---
# Requires SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above and AWS_* for Bedrock (unless npm run seed:no-embeddings).
# In Supabase Dashboard → Auth → Phone: enable Phone and set Test OTPs (see tools/supabase-seed/README.md).
MATCH_RECEIPT_EDGE_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/match-receipt-items
PLACE_ORDER_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/place-order
