{
  "expo": {
    "name": "Crave",
    "slug": "crave-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "crave",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "us.trycrave.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Crave uses your location to show restaurants near you on the recommendations tab."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.hawkings232.myapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Crave to choose photos for your profile and receipts.",
          "cameraPermission": "Allow Crave to use the camera for your profile and receipts."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Crave uses your location to show restaurants near you on the recommendations tab."
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
